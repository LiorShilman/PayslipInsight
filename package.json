{
  "name": "payslip-insight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && node scripts/check-rtl.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "extract": "tsx packages/extract/src/cli.ts",
    "gen:fixtures": "tsx scripts/generate-fixtures.ts",
    "gen:jsonschema": "tsx packages/extract/scripts/gen-jsonschema.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@napi-rs/canvas": "^0.1.100",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.15.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.8"
  }
}
